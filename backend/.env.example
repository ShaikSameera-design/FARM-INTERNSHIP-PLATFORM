# Copy to backend/.env and edit.  Real environment variables always win over this file.

# development | production
ENVIRONMENT=development

# PostgreSQL (recommended; required when ENVIRONMENT=production).
# Leave empty in development to fall back to a local SQLite file (backend/farmintern.db).
DATABASE_URL=postgresql://farm_user:CHANGE_ME@localhost:5432/farm_internship_db

# REQUIRED in production: random string >= 32 chars.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=

# Browser origins allowed to call the API when the frontend is hosted separately (comma separated).
# Not needed when the backend serves the built frontend itself (single-origin deployment).
CORS_ORIGINS=http://localhost:5173

# Public URL of the website (used inside password-reset e-mails).
FRONTEND_URL=http://localhost:5173

# Password reset: in production configure SMTP; the API never returns the link there.
# EXPOSE_RESET_LINK=true only for local testing without e-mail.
EXPOSE_RESET_LINK=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Farmers must be verified by an admin before publishing (default: on in production).
# REQUIRE_FARMER_VERIFICATION=true
