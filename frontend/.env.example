# Frontend build-time settings (copy to .env.production when the API is on a DIFFERENT origin).
# Leave unset when the backend serves the built frontend, or in local development (Vite proxy).
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com
# Optional TURN relay for calls across strict NATs/firewalls:
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
